# Environment Variables — LCMS
# Copy this file to .env.local and fill in your values
# Never commit .env.local to GitHub

# ─── Supabase ───────────────────────────────────────────
# Found in: Supabase Dashboard → Project Settings → API

# Your Supabase project URL (safe to expose to browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Public anon key (safe to expose to browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service role key — SERVER SIDE ONLY — never use in client components
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ─── App ───────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=LCMS

# ─── Email (Resend) ─────────────────────────────────────────
# Get your API key at https://resend.com — free tier: 3k emails/month
RESEND_API_KEY=your-resend-api-key-here
# The verified sender address in your Resend account
RESEND_FROM_EMAIL=noreply@yourdomain.com
