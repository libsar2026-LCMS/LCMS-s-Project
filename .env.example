# Environment Variables — LCMS
# Copy this file to .env.local and fill in your values
# Never commit .env.local to GitHub

# ─── Supabase ───────────────────────────────────────────
# Found in: Supabase Dashboard → Project Settings → API

# Your Supabase project URL (safe to expose to browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Public anon key (safe to expose to browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service role key — SERVER SIDE ONLY — never use in client components
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ─── App ───────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=LCMS

# ─── Email (Resend) ─────────────────────────────────────────
# Get your API key at https://resend.com — free tier: 3k emails/month
RESEND_API_KEY=your-resend-api-key-here

# The verified sender address in your Resend account.
# During development you can use: onboarding@resend.dev (sends to your Resend account email only)
# In production use your verified domain: noreply@libsar.org
RESEND_FROM_EMAIL=noreply@libsar.org

# ─── Email Triggers ──────────────────────────────────────────
# Emails are sent automatically on these events:
#   welcome            — after self-registration
#   pending_approval   — after self-registration (membership pending)
#   member_approved    — when admin approves a member
#   member_rejected    — when admin rejects a member
#   forgot_password    — password reset request (via Supabase)
#   password_changed   — after password is successfully changed
#   login_notification — on every successful sign-in
#   role_updated       — when admin changes a user's role
#   admin_created_account — when admin creates a user with temp password
#   account_disabled   — when membership status is set to suspended
#
# All sent emails are logged in the email_logs table (Supabase).
# Run: supabase/migrations/009_email_logs.sql to create the table.
